# Optional variable names only. Defaults and shell-export instructions are in README.md.
# Frontend: public configuration, never credentials; Vite reads apps/web/.env.local.
VITE_API_BASE_URL=
# Backend: exported local CORS origins and SQLite file path; no .env loader.
CIVICPLAIN_ALLOWED_ORIGINS=
CIVICPLAIN_DATABASE_PATH=
# Backend M5 optional provider; deterministic is the default. No dotenv auto-loader.
CIVICPLAIN_AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
CIVICPLAIN_AI_MAX_CALLS_PER_HOUR=
# M7.1 backend workspace selection; v1 stays synthetic. Official requires a published pinned snapshot.
CIVICPLAIN_DATA_MODE=
CIVICPLAIN_OFFICIAL_SNAPSHOT_ID=
# M7.2 public read-only municipal API URL, independent of the v1 URL.
VITE_MUNICIPAL_API_BASE_URL=
# M7.2 basemap: osm (default interactive tiles) or local (no external tile requests).
VITE_BASEMAP=
# Supplied standardized read model; backend read-only, independent of the planning database.
CIVICPLAIN_STANDARDIZED_DATABASE_PATH=
